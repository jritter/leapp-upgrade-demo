# Copy to lab/config.env and adjust paths as needed.
# Source this file from create/destroy scripts automatically when present.

LIBVIRT_URI="${LIBVIRT_URI:-qemu:///system}"
LIBVIRT_NETWORK="${LIBVIRT_NETWORK:-default}"

# Directory layout (relative to repo root by default)
LAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${LAB_DIR}/.." && pwd)"
IMAGES_DIR="${IMAGES_DIR:-${LAB_DIR}/images}"
DISKS_DIR="${DISKS_DIR:-${LAB_DIR}/disks}"
CLOUD_INIT_DIR="${CLOUD_INIT_DIR:-${LAB_DIR}/cloud-init/generated}"

# Official RHEL KVM guest images (place downloaded qcow2 files here)
RHEL8_IMAGE="${RHEL8_IMAGE:-${IMAGES_DIR}/rhel-8.10-x86_64-kvm.qcow2}"
RHEL9_IMAGE="${RHEL9_IMAGE:-${IMAGES_DIR}/rhel-9.8-x86_64-kvm.qcow2}"

# Guest sizing (Leapp needs disk headroom)
VM_VCPUS="${VM_VCPUS:-2}"
VM_MEMORY_MIB="${VM_MEMORY_MIB:-4096}"
VM_DISK_GIB="${VM_DISK_GIB:-40}"

# cloud-init / SSH
VM_USER="${VM_USER:-cloud-user}"
SSH_PUBKEY_FILE="${SSH_PUBKEY_FILE:-}"
