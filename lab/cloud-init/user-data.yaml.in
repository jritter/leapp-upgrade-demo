#cloud-config
hostname: __HOSTNAME__
fqdn: __HOSTNAME__.lab.local
manage_etc_hosts: true

users:
  - default
  - name: __VM_USER__
    groups: [wheel]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    ssh_authorized_keys:
      - __SSH_PUBKEY__

ssh_pwauth: false
disable_root: true

growpart:
  mode: auto
  devices: ["/"]
  ignore_growroot_disabled: false

runcmd:
  - |
    set -euo pipefail
    if command -v subscription-manager >/dev/null 2>&1; then
      subscription-manager register \
        --org="__RHSM_ORG__" \
        --activationkey="__RHSM_ACTIVATIONKEY__" \
        --force || true
      subscription-manager attach --auto || true
    fi
  - ['bash', '-c', 'P=$(tr -dc A-Za-z0-9 </dev/urandom | head -c16); echo "__VM_USER__:$P" | chpasswd; echo "Cockpit password for __VM_USER__: $P" > /home/__VM_USER__/.cockpit-password; chmod 600 /home/__VM_USER__/.cockpit-password; chown __VM_USER__:__VM_USER__ /home/__VM_USER__/.cockpit-password; echo "Cockpit: __VM_USER__ / $P" | tee /dev/console']
  - ['bash', '-c', 'insights-client --register || true']
  - ['bash', '-c', 'dnf install -y cockpit-leapp || true']
  - ['bash', '-c', 'systemctl enable --now cockpit.socket || true']
  - ['bash', '-c', 'touch /var/lib/cloud/instance/leapp-lab-ready']

final_message: "leapp-upgrade-demo guest __HOSTNAME__ is ready"
