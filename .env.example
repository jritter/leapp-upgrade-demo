# Red Hat Subscription Manager (required for CDN registration)
# Prefer an activation key + org ID from https://console.redhat.com
export RHSM_ORG="123456"
export RHSM_ACTIVATIONKEY="activation-key"

# Optional: override the SSH public key injected via cloud-init
#export SSH_PUBKEY="$(cat ~/.ssh/id_ed25519.pub)"

# Automation Hub offline token (required to build the EE with infra.leapp)
# https://console.redhat.com/ansible/automation-hub/token
# export AUTOMATION_HUB_TOKEN=""
# export ANSIBLE_GALAXY_SERVER_AUTOMATION_HUB_TOKEN=""
